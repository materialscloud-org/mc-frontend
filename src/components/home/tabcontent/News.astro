---
// Knightlab timeline from their CDN.
// Script only fires on loading of the news tab allowing efficient
const timelineUrl =
  "https://docs.google.com/spreadsheets/d/1nSOakYvr0edaU24mZfO7jp2f6OxcqdWBaVbnL5Anm7Q/pubhtml";

const options = {
  initial_zoom: 5,
  height: 500,
  timenav_height: 150,
  timenav_height_min: 150,
  start_at_end: true,
  animation: 250,
  marker_padding: 4,
};
---

<!-- TimelineJS CSS -->
<link
  rel="stylesheet"
  href="https://cdn.knightlab.com/libs/timeline3/latest/css/timeline.css"
/>

<!-- News tab content container -->
<div id="news-timeline-container"></div>

<script type="module" define:vars={{ timelineUrl, options }}>
  let initialized = false;

  function initTimeline() {
    if (initialized) return;

    const container = document.createElement("div");
    container.id = "timeline-embed";
    container.style.width = "100%";
    container.style.height = "500px";

    document.getElementById("news-timeline-container").appendChild(container);

    // get the timeline script now.
    if (!window.TL) {
      const script = document.createElement("script");
      script.src =
        "https://cdn.knightlab.com/libs/timeline3/latest/js/timeline-min.js";
      script.onload = () => {
        new TL.Timeline("timeline-embed", timelineUrl, options);
      };
      document.body.appendChild(script);
    } else {
      new TL.Timeline("timeline-embed", timelineUrl, options);
    }

    initialized = true;
  }

  // init if newsEvent fires
  window.addEventListener("newsTabActivated", initTimeline);

  // init if #news is entered into URL.
  if (window.location.hash === "#news") {
    initTimeline();
  }
</script>
