---
import fs from "fs";
import yaml from "js-yaml";

// Load YAML data at build time
const file = fs.readFileSync("./src/data/partners.yml", "utf8");
const data = yaml.load(file);

const sections = [
  { title: "Supported by", entries: data.supporters },
  { title: "Partners - Supercomputing Centers", entries: data.supercomps },
  { title: "Recommended by", entries: data.recommendors },
  { title: "Indexed by", entries: data.indexed },
];

// Styles
const partnerCardStyle = "flex items-center space-x-4 px-6 py-2 bg-white";
const gridStyle = "grid grid-cols-1 md:grid-cols-2 gap-4";
const logoStyle = "flex-shrink-0 w-24 h-24";
---

<div id="partners" class="space-y-8">
  {
    sections.map((section) => (
      <div class="space-y-4">
        <h3 class="text-xl text-center">{section.title}</h3>
        <div class={gridStyle}>
          {section.entries.map((entry) => (
            <div class={`${partnerCardStyle}`}>
              <div class={logoStyle}>
                <img
                  src={`images/endorsers/${entry.logo}`}
                  alt={`${entry.name} logo`}
                  class="w-full h-full object-contain"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="flex flex-col">
                <h4 class="text-lg font-medium">{entry.name}</h4>

                {/* First URL */}
                {entry.url && (
                  <a
                    class="break-all"
                    href={entry.url}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {new URL(entry.url).hostname}
                  </a>
                )}

                {/* Optional second URL */}
                {entry.url2 && entry.url2_str && (
                  <a
                    class="break-all"
                    href={entry.url2}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {entry.url2_str.replace(/^https?:\/\//, "")}
                  </a>
                )}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))
  }
</div>
