---
const {
  href,
  img,
  title,
  subtitle = null,
  width = "w-64",
  height = "h-40",
  breadcrumbText = null,
  backgroundColor = null,
  clickable = true,
} = Astro.props;

const buttonStyle = `block flex flex-col items-center justify-center text-center no-underline relative`;
---

<div
  class={`entry-container-carousel ${width} ${height} my-0.5 ${backgroundColor}`}
>
  <a
    href={clickable ? href : undefined}
    target={clickable && href.startsWith("http") ? "_blank" : undefined}
    class={`${buttonStyle} ${!clickable ? "pointer-events-none" : ""}`}
  >
    {
      breadcrumbText && (
        <div class="absolute -top-3 -left-2 text-slate-600 text-xs pointer-events-none">
          <span>{breadcrumbText}</span>
        </div>
      )
    }

    <img class="entry-image h-14" src={img} alt="" />
    <h3 class="entry-title">{title}</h3>
    {subtitle && <p class="entry-description">{subtitle}</p>}
  </a>
</div>
