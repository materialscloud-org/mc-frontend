---
import Layout from "@layouts/Layout.astro";
import RectangleButton from "@components/RectangleButton.astro";
import BannerList from "@components/BannerList.astro";

import fs from "fs";
import yaml from "js-yaml";

const tfile = fs.readFileSync("./src/data/work/tools.yml", "utf8");
const tools = yaml.load(tfile);

const wbfile = fs.readFileSync("./src/data/work/topButtons.yml", "utf-8");
const wbData = yaml.load(wbfile);

const workButtons = wbData.workButtons;
const style = wbData.style;

workButtons[0].backgroundColor = wbData.style.backgroundColor;
workButtons[0].clickable = wbData.style.clickable;

const breadcrumbs = [
  { name: "Work", href: "work" },
  { name: "Tools", href: null },
];
---

<Layout
  breadcrumbs={breadcrumbs}
  title="Work - Tools"
  description=`Materials Cloud Work - Simulation tools and services, in the cloud or on your computer`
>
  <div class="space-y-10">
    <section class="space-y-4">
      <h1 class="text-2xl">Work with your data</h1>
      <hr class="border-t border-gray-300 mb-6" />

      <div
        class="mx-auto flex flex-col sm:flex-row sm:flex-wrap justify-center gap-4 sm:gap-6 items-center"
      >
        {
          workButtons.map((btn) => (
            <RectangleButton
              href={btn.href}
              img={btn.img}
              title={btn.title}
              subtitle={btn.subtitle}
              backgroundColor={btn.backgroundColor}
              clickable={btn.clickable}
            />
          ))
        }
      </div>
    </section>
    <section class="space-y-4">
      <h2 class="text-xl">Tools</h2>
      <hr class="border-t border-gray-300 mb-6" />

      <p>
        Computational tools offered as a service: no download, no installation,
        but click-and-run.
      </p>
      <BannerList entries={tools.menu.main_tools} rootPath="work/tools" />
    </section>
    <!-- <section>
      <h2 class="text-xl mb-2">Contributed Tools</h2>
      <p class="mb-4">
        The tools below have been contributed and are maintained by authors
        affiliated with the <a
          href="https://www.materialscloud.org/home#partners"
          >Materials Cloud partners</a
        >.
      </p>
      <BannerList
        entries={tools.menu.contributed_tools}
        rootPath="work/tools"
      />
    </section> -->

    <section>
      <h2 class="text-xl mb-2">External tools</h2>
      <p class="mb-4">
        The tools below are affiliated with the <a
          href="https://www.materialscloud.org/home#partners"
          >Materials Cloud partners</a
        > but are now hosted externally.
      </p>
      <BannerList entries={tools.menu.external_tools} rootPath="work/tools" />
    </section>
  </div>
</Layout>
