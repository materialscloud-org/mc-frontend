---
import Layout from "@layouts/Layout.astro";
import RectangleButton from "@components/RectangleButton.astro";

import fs from "fs";
import yaml from "js-yaml";

export async function getStaticPaths() {
  const file = fs.readFileSync("./src/data/work/tools.yml");
  const tools = yaml.load(file);

  return tools.menu.external_tools.map((tool) => ({
    params: { external: tool.link },
    props: { tool },
  }));
}

const { tool: page } = Astro.props;

const breadcrumbs = [
  { name: "Work", href: "work" },
  { name: "Tools", href: "work/tools" },
  { name: page.title, href: `work/tools/${page.link}` },
];

const dockerPull = `docker pull ${page.dockerhubIMAGE}`;
const dockerRun = `docker run ${page.dockerhubIMAGE}`;
---

<Layout
  breadcrumbs={breadcrumbs}
  title={page.title}
  description={`Materials Cloud - Work. ${page.title}`}
>
  <h3 class="text-center">{page.title}</h3>
  <div class="text-center pt-1 pb-2 mb- border-b border-gray-800">
    {page.authors}
  </div>
  <section class="py-4">
    <span class="font-bold">Description:</span>
    {page.description}
  </section>
  <div>
    {page.descriptionExt && <div set:html={page.descriptionExt} />}
  </div>

  <p class="italic pt-8 py-4 font-medium text-center">
    Note: this tool is hosted externally by the tool authors.
  </p>

  <div class="flex flex-wrap justify-center gap-4">
    <RectangleButton
      href={page.externalWebURL}
      img={`images/logos/${page.logo}`}
      title="Run the tool live"
      subtitle="on render.com (might take ~1-2 minutes to load)"
    />

    <RectangleButton
      href={page.sourceCodeURL}
      img={`images/logos/github.svg`}
      title="Check the source code"
      subtitle="On GitHub"
    />

    <RectangleButton
      href={page.dockerhubURL}
      img={`images/logos/docker.png`}
      title="Find the Docker image"
      subtitle="on DockerHub"
    />
  </div>
</Layout>
