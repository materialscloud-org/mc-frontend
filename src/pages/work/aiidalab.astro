---
import Layout from "@layouts/Layout.astro";
import RectangleButton from "@components/RectangleButton.astro";
import BannerList from "@components/BannerList.astro";

import fs from "fs";
import yaml from "js-yaml";

const tfile = fs.readFileSync("./src/data/aiidalab-deployments.yml", "utf8");

const aiidalab_deployments = yaml.load(tfile);

const workButtons = [
  {
    href: "work",
    img: "images/work_tools.png",
    title: "Tools",
    subtitle: "Click and run computational tools.",
  },
  {
    href: "work/aiidalab",
    img: "images/aiidalab_gears.png",
    title: "AiiDAlab",
    subtitle: "Run your own simulations using AiiDA on the cloud",
    backgroundcolor: "bg-slate-50",
    clickable: false,
  },
  {
    href: "https://quantum-mobile.readthedocs.io",
    img: "images/quantum_mobile.png",
    title: "Quantum Mobile",
    subtitle: "Quantum simulation codes + AiiDA in a virtual machine",
  },
];

const breadcrumbs = [
  { name: "Work", href: "work" },
  { name: "Aiidalab", href: "work/aiidalab" },
];
---

<Layout
  breadcrumbs={breadcrumbs}
  title="Aiidalab"
  description=`Materials Cloud Work - Simulation tools and services, in the cloud or on your computer`
>
  <div class="space-y-10">
    <section class="space-y-4">
      <h3 class="text-2xl">Work with your data</h3>
      <hr class="border-t border-gray-300 mb-6" />

      <div
        class="mx-auto flex flex-col sm:flex-row sm:flex-wrap justify-center gap-4 sm:gap-6 items-center"
      >
        {
          workButtons.map((btn) => (
            <RectangleButton
              href={btn.href}
              img={btn.img}
              title={btn.title}
              subtitle={btn.subtitle}
              clickable={btn.clickable}
            />
          ))
        }
      </div>
    </section>
    <section class="space-y-4">
      <h3 class="text-xl">AiiDAlab</h3>
      <hr class="border-t border-gray-300 mb-6" />

      <p>
        Run complex and robust AiiDA workflows with tailored lightweight web
        applications directly in the browser.
      </p>
      <BannerList entries={aiidalab_deployments} rootPath="work/tools" />
    </section>
  </div>
</Layout>
