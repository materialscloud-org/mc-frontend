---
import Layout from "@layouts/Layout.astro";
import RectangleButton from "@components/RectangleButton.astro";
import BannerList from "@components/BannerList.astro";

import fs from "fs";
import yaml from "js-yaml";

const tfile = fs.readFileSync(
  "./src/data/work/aiidalab-deployments.yml",
  "utf8",
);

const aiidalab_deployments = yaml.load(tfile);

const wbfile = fs.readFileSync("./src/data/work/topButtons.yml", "utf-8");
const wbData = yaml.load(wbfile);

const hometfile = fs.readFileSync(
  "./src/data/work/aiidalab-homepage.yml",
  "utf8",
);

const aiidalab_homepage = yaml.load(hometfile);

const hometfile__ = fs.readFileSync(
  "./src/data/work/aiidalab-deployments_local.yml",
  "utf8",
);

const aiidalab_dep_local__ = yaml.load(hometfile__);

const workButtons = wbData.workButtons;
const style = wbData.style;

workButtons[1].backgroundColor = wbData.style.backgroundColor;
workButtons[1].clickable = wbData.style.clickable;

const breadcrumbs = [
  { name: "Work", href: "work" },
  { name: "AiiDAlab", href: "work/AiiDAlab" },
];
---

<Layout
  breadcrumbs={breadcrumbs}
  title="Work - AiiDAlab"
  description=`Materials Cloud Work - Simulation tools and services, in the cloud or on your computer`
>
  <div class="space-y-10">
    <section class="space-y-4">
      <h1 class="text-2xl">Work with your data</h1>
      <hr class="border-t border-gray-300 mb-6" />

      <div
        class="mx-auto flex flex-col sm:flex-row sm:flex-wrap justify-center gap-4 sm:gap-6 items-center"
      >
        {
          workButtons.map((btn) => (
            <RectangleButton
              href={btn.href}
              img={btn.img}
              title={btn.title}
              subtitle={btn.subtitle}
              backgroundColor={btn.backgroundColor}
              clickable={btn.clickable}
            />
          ))
        }
      </div>
    </section>
    <section class="space-y-4">
      <h2 class="text-xl">AiiDAlab deployments</h2>
      <hr class="border-t border-gray-300 mb-6" />

      <p>
        Materials Cloud and several institutions offer <a
          href="https://www.aiidalab.net"
          target="_blank"
          rel="noopener noreferrer">AiiDAlab</a
        > as a maintained web deployment.

        <BannerList entries={aiidalab_deployments} rootPath="work/tools" />
      </p>
    </section>

    <section class="space-y-4">
      <p>
        Alternatively you can easily deploy AiiDAlab yourself (e.g. on your
        laptop or workstation).

        <BannerList entries={aiidalab_dep_local__} rootPath="work/tools" />
      </p>
    </section>

    <section class="space-y-4">
      <h2 class="text-xl">About AiiDAlab</h2>
      <hr class="border-t border-gray-300 mb-6" />

      <BannerList entries={aiidalab_homepage} rootPath="work/tools" />
    </section>
  </div>
</Layout>
